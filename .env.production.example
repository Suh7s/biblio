# Copy to .env.production, chmod 600, and keep it outside source control.
PUBLIC_ORIGIN=https://library.example.edu
MONGODB_URI=mongodb+srv://<least-privilege-user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-openssl-rand-hex-32-output
# The example topology is an outer institutional TLS proxy in front of the nginx container.
TRUST_PROXY_HOPS=2
OPENAI_API_KEY=replace-with-a-server-side-provider-key
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_CHAT_MODEL=gpt-4o-mini
AI_VECTOR_MODE=atlas
AI_VECTOR_INDEX=book_chunks_vector
AI_MIN_RELEVANCE=0.65
AI_EXACT_MAX_CHUNKS=5000
AI_TIMEOUT_MS=25000
