{
  "info": {
    "name": "LIBRAMIND API",
    "description": "Books and catalogue requests. Set baseUrl and token (a JWT for a USER or ADMIN) in the collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "token", "value": "" },
    { "key": "bookId", "value": "" },
    {"key": "userToken", "value": ""},
    {"key": "adminToken", "value": ""},
    {"key": "sourceId", "value": "library-notes"},
    {"key": "licensedSourceText", "value": ""}
  ],
  "item": [
    {
      "name": "Books",
      "item": [
        { "name": "Browse books (USER or ADMIN)", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/books?page=1&limit=12&search=robotics&category=Engineering&sort=-year", "host": ["{{baseUrl}}"], "path": ["books"], "query": [{"key":"page","value":"1"},{"key":"limit","value":"12"},{"key":"search","value":"robotics"},{"key":"category","value":"Engineering"},{"key":"sort","value":"-year"}] }, "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] } }, "response": [] },
        { "name": "Browse without token (401 failure case)", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/books", "auth": { "type": "noauth" } }, "response": [] },
        { "name": "Get book details", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/books/{{bookId}}", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] } }, "response": [] },
        { "name": "Create book (ADMIN)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Modern Robotics\",\n  \"authors\": [\"Kevin M. Lynch\", \"Frank C. Park\"],\n  \"isbn\": \"9781107156302\",\n  \"description\": \"A comprehensive introduction to robotics.\",\n  \"category\": \"Engineering\",\n  \"tags\": [\"robotics\", \"control\"],\n  \"publisher\": \"Cambridge University Press\",\n  \"publicationYear\": 2017,\n  \"totalCopies\": 4,\n  \"availableCopies\": 4,\n  \"shelfLocation\": \"ENG-ROB-001\",\n  \"coverImage\": \"\"\n}" }, "url": "{{baseUrl}}/books", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] } }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) {", "  const body = pm.response.json();", "  if (body.data?.book?._id) pm.collectionVariables.set('bookId', body.data.book._id);", "}"] } }], "response": [] },
        { "name": "Create book as USER (403 failure case)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"title\":\"Forbidden test\",\"authors\":[\"Test\"],\"isbn\":\"TEST-403\",\"category\":\"Test\",\"totalCopies\":1,\"availableCopies\":1}" }, "url": "{{baseUrl}}/books", "auth": { "type": "bearer", "bearer": [{ "key": "userToken", "value": "{{token}}", "type": "string" }] } }, "response": [] },
        { "name": "Update book / inventory (ADMIN)", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"totalCopies\": 5,\n  \"availableCopies\": 5,\n  \"shelfLocation\": \"ENG-ROB-002\"\n}" }, "url": "{{baseUrl}}/books/{{bookId}}", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] } }, "response": [] },
        { "name": "Reject invalid inventory (400 failure case)", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"totalCopies\":1,\"availableCopies\":2}" }, "url": "{{baseUrl}}/books/{{bookId}}", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] } }, "response": [] },
        { "name": "Delete book (ADMIN; 409 if active circulation)", "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/books/{{bookId}}", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] } }, "response": [] }
      ]
    },
    {
      "name": "Categories",
      "item": [
        { "name": "List categories (USER or ADMIN)", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/categories", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] } }, "response": [] }
      ]
    },
    {
      "name": "AI",
      "item": [
        {
          "name": "Semantic search \u2014 concept query",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ai/search?q=How%20robots%20perceive%20and%20navigate&limit=8",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Shared response envelope', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.test('Ranked canonical books', () => { for (const result of pm.response.json().data.results) { pm.expect(result.book._id).to.match(/^[a-f0-9]{24}$/); pm.expect(result.relevance).to.be.within(0, 1); pm.expect(result.reason).to.be.a('string'); } });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Available resources only",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ai/search?q=robotics&availableOnly=true",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Shared response envelope', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.test('Positive available copies', () => pm.response.json().data.results.forEach(r => pm.expect(r.book.availableCopies).to.be.above(0)));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Ask grounded prerequisites",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/ai/ask",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"What should I read before learning reinforcement learning?\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Shared response envelope', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.test('Attribution or explicit abstention', () => { const d = pm.response.json().data; pm.expect(d.answer).to.be.a('string'); if (!d.insufficientContext) pm.expect(d.sources.length).to.be.above(0); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Learning path \u2014 8 weeks",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/ai/learning-path",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"goal\": \"Learn robotics\",\n  \"durationWeeks\": 8,\n  \"background\": \"Python and calculus\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Shared response envelope', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.test('Schedule covers requested duration when supported', () => { const d = pm.response.json().data; if (!d.insufficientContext) { pm.expect(d.steps[0].startWeek).to.eql(1); pm.expect(d.steps[d.steps.length-1].endWeek).to.eql(8); } });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Personal recommendations",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ai/recommendations?limit=6",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Shared response envelope', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Index catalogue source \u2014 ADMIN",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/ai/books/{{bookId}}/index",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Shared response envelope', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Index actual excerpt \u2014 ADMIN (replace content before use)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/ai/books/{{bookId}}/chunks",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceId\": \"library-notes\",\n  \"sections\": [\n    {\n      \"chapter\": \"\",\n      \"section\": \"\",\n      \"content\": \"{{licensedSourceText}}\"\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Shared response envelope', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Delete source \u2014 ADMIN",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/ai/books/{{bookId}}/chunks/{{sourceId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Shared response envelope', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Missing authentication \u2014 clear Postman cookies first",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ai/search?q=robotics",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
                  "pm.test('Shared response envelope', () => pm.expect(pm.response.json().success).to.eql(false));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Blank query rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/ai/ask",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \" \"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
                  "pm.test('Shared response envelope', () => pm.expect(pm.response.json().success).to.eql(false));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Invalid learning duration rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/ai/learning-path",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"goal\": \"Learn robotics\",\n  \"durationWeeks\": 0\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
                  "pm.test('Shared response envelope', () => pm.expect(pm.response.json().success).to.eql(false));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "USER cannot index sources",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/ai/books/{{bookId}}/index",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 403', () => pm.response.to.have.status(403));",
                  "pm.test('Shared response envelope', () => pm.expect(pm.response.json().success).to.eql(false));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Invalid Book ID rejected",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/ai/books/not-an-id/index",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
                  "pm.test('Shared response envelope', () => pm.expect(pm.response.json().success).to.eql(false));"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ]
}
