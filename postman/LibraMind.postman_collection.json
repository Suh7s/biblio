                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ada Reader\",\n  \"email\": \"ada.reader@example.edu\",\n  \"password\": \"Reading123!\",\n  \"interests\": [\n    \"robotics\",\n    \"history\"\n  ]\n}"
            },
