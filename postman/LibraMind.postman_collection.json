{
  "info": {
    "name": "LIBRAMIND API",
    "description": "LibraMind REST API. Auth uses the HTTP-only token cookie; Postman cookie jar retains it after login. Configure baseUrl, token (if using Bearer auth), userToken, bookId, borrowId and reservationId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "bookId",
      "value": ""
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "borrowId",
      "value": ""
    },
    {
      "key": "reservationId",
      "value": ""
    },
    {
      "key": "notificationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Books",
      "item": [
        {
          "name": "Browse books (USER or ADMIN)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?page=1&limit=12&search=robotics&category=Engineering&sort=-year",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "12"
                },
                {
                  "key": "search",
                  "value": "robotics"
                },
                {
                  "key": "category",
                  "value": "Engineering"
                },
                {
                  "key": "sort",
                  "value": "-year"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Browse without token (401 failure case)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/books",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Get book details",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/books/{{bookId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create book (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Modern Robotics\",\n  \"authors\": [\"Kevin M. Lynch\", \"Frank C. Park\"],\n  \"isbn\": \"9781107156302\",\n  \"description\": \"A comprehensive introduction to robotics.\",\n  \"category\": \"Engineering\",\n  \"tags\": [\"robotics\", \"control\"],\n  \"publisher\": \"Cambridge University Press\",\n  \"publicationYear\": 2017,\n  \"totalCopies\": 4,\n  \"availableCopies\": 4,\n  \"shelfLocation\": \"ENG-ROB-001\",\n  \"coverImage\": \"\"\n}"
            },
            "url": "{{baseUrl}}/books",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.data?.book?._id) pm.collectionVariables.set('bookId', body.data.book._id);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Create book as USER (403 failure case)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Forbidden test\",\"authors\":[\"Test\"],\"isbn\":\"TEST-403\",\"category\":\"Test\",\"totalCopies\":1,\"availableCopies\":1}"
            },
            "url": "{{baseUrl}}/books",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "userToken",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update book / inventory (ADMIN)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"totalCopies\": 5,\n  \"availableCopies\": 5,\n  \"shelfLocation\": \"ENG-ROB-002\"\n}"
            },
            "url": "{{baseUrl}}/books/{{bookId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Reject invalid inventory (400 failure case)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"totalCopies\":1,\"availableCopies\":2}"
            },
            "url": "{{baseUrl}}/books/{{bookId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete book (ADMIN; 409 if active circulation)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/books/{{bookId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "List categories (USER or ADMIN)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/categories",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Borrowing",
      "item": [
        {
          "name": "Borrow book — success",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/borrow/{{bookId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Loan created', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json().data;",
                  "if (data?.borrow?._id) pm.collectionVariables.set('borrowId', data.borrow._id);",
                  "pm.test('Loan includes book and due date', () => { pm.expect(data.borrow.book).to.exist; pm.expect(data.borrow.dueDate).to.exist; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Borrow duplicate — expected 409",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/borrow/{{bookId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Duplicate loan rejected', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "My borrowing history",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/borrow/my",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Borrow history loaded', () => pm.response.to.have.status(200));",
                  "pm.test('History array returned', () => pm.expect(pm.response.json().data.borrows).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Renew loan — success",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/borrow/{{borrowId}}/renew",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Renewal accepted', () => pm.response.to.have.status(200));",
                  "pm.test('Renewal count incremented', () => pm.expect(pm.response.json().data.borrow.renewedCount).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Return loan — success",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/borrow/{{borrowId}}/return",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Return accepted', () => pm.response.to.have.status(200));",
                  "pm.test('Loan marked returned', () => pm.expect(pm.response.json().data.borrow.status).to.eql('RETURNED'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Reservations",
      "item": [
        {
          "name": "Reserve unavailable book — success",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/reservations/{{bookId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reservation created', () => pm.response.to.have.status(201));",
                  "const r = pm.response.json().data.reservation;",
                  "if (r?._id) pm.collectionVariables.set('reservationId', r._id);",
                  "pm.test('Queue position returned', () => pm.expect(r.position).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "My reservations",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/reservations/my",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reservations loaded', () => pm.response.to.have.status(200));",
                  "pm.test('Reservation list returned', () => pm.expect(pm.response.json().data.reservations).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel reservation — success",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/reservations/{{reservationId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reservation cancelled', () => pm.response.to.have.status(200));",
                  "pm.test('Cancellation status returned', () => pm.expect(pm.response.json().data.reservation.status).to.eql('CANCELLED'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Fines",
      "item": [
        {
          "name": "Get my fines",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/fines/my",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Fines loaded', () => pm.response.to.have.status(200));",
                  "pm.test('Fines and balance returned', () => { const d=pm.response.json().data; pm.expect(d.fines).to.be.an('array'); pm.expect(d.totalUnpaid).to.be.a('number'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "List my notifications",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/notifications",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Notifications loaded', () => pm.response.to.have.status(200));",
                  "pm.test('Notification list and unread count returned', () => { const d=pm.response.json().data; pm.expect(d.notifications).to.be.an('array'); pm.expect(d.unread).to.be.a('number'); });",
                  "const notices = pm.response.json().data.notifications;",
                  "if (notices.length) pm.collectionVariables.set('notificationId', notices[0]._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Mark notification read",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/notifications/{{notificationId}}/read",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Notification marked read', () => pm.response.to.have.status(200));",
                  "pm.test('Read state is true', () => pm.expect(pm.response.json().data.notification.read).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
