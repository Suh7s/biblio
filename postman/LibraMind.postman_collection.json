            },
            "url": "{{baseUrl}}/books",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.data?.book?._id) pm.collectionVariables.set('bookId', body.data.book._id);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
