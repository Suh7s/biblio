PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/libramind
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
LOAN_DAYS=14
MAX_RENEWALS=2
RESERVATION_HOLD_DAYS=3
FINE_PER_DAY=1

# Developer 4: AI (server-side only; never set these with a VITE_ prefix)
OPENAI_API_KEY=
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_CHAT_MODEL=gpt-4o-mini
# atlas in production; exact for small local collections (same embeddings, no keyword fallback)
AI_VECTOR_MODE=atlas
AI_VECTOR_INDEX=book_chunks_vector
AI_MIN_RELEVANCE=0.65
AI_EXACT_MAX_CHUNKS=5000
AI_TIMEOUT_MS=25000
